{
  "id": "layout-studio",
  "name": "Listening Console",
  "creators": [
    "YoZiNu"
  ],
  "blurb": "Playback, lyrics and the queue sit together in a listening panel.",
  "source": "YoZiNu layout",
  "accent": "#b84237",
  "background": {
    "mode": "solid",
    "solid": "#2b171c",
    "solid_light": "#fff5ee",
    "scrim": 0.05
  },
  "lyrics": {
    "rem": 12,
    "line_height": 1.28
  },
  "chrome": {
    "bar_height": 72,
    "bar_color": "#2b171c",
    "play_button": "accent",
    "progress_color": "accent",
    "progress_px": 2
  },
  "app": {
    "card_radius": 11,
    "thumb_radius": 6,
    "panel_radius": 10,
    "search_radius": 8,
    "search_border": 0.17,
    "search_alpha": 0.07,
    "accent_controls": true,
    "text_dim": "#cba7a7",
    "np_solid": "#2b171c",
    "heading_px": 22,
    "bar_border": true,
    "bar_alpha": 1,
    "controls": {
      "accent_primary": true
    },
    "search_look": {
      "height": 39,
      "max_px": 840
    }
  }
}
