{
  "id": "layout-console",
  "name": "Studio Console",
  "creators": [
    "YoZiNu"
  ],
  "blurb": "A three-column Hi-Fi station: a multi-column catalog table, a fixed now-playing inspector and a waveform progress bar.",
  "source": "YoZiNu layout",
  "accent": "#10b981",
  "background": {
    "mode": "solid",
    "solid": "#0a0b0e",
    "solid_light": "#f5f7fa",
    "scrim": 0.04
  },
  "lyrics": {
    "rem": 11,
    "line_height": 1.26
  },
  "chrome": {
    "bar_height": 68,
    "bar_color": "#0d0f13",
    "play_button": "accent",
    "progress_color": "accent",
    "progress_px": 2,
    "bar_border_alpha": 0.1
  },
  "app": {
    "card_radius": 6,
    "thumb_radius": 4,
    "panel_radius": 6,
    "search_radius": 6,
    "search_border": 0.16,
    "search_alpha": 0.06,
    "accent_controls": true,
    "text_dim": "#94a3b8",
    "np_solid": "#0a0b0e",
    "heading_px": 20,
    "bar_border": true,
    "bar_alpha": 1,
    "controls": {
      "accent_primary": true
    },
    "search_look": {
      "height": 34,
      "max_px": 620
    }
  }
}
