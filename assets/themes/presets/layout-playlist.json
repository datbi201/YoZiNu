{
  "id": "layout-playlist",
  "name": "Music Library",
  "creators": [
    "YoZiNu"
  ],
  "blurb": "A music library with source columns and an easy-to-scan playlist.",
  "source": "YoZiNu layout",
  "accent": "#a94412",
  "background": {
    "mode": "solid",
    "solid": "#30261e",
    "solid_light": "#fbf5ed",
    "scrim": 0.05
  },
  "lyrics": {
    "rem": 12,
    "line_height": 1.28
  },
  "chrome": {
    "bar_height": 72,
    "bar_color": "#30261e",
    "play_button": "accent",
    "progress_color": "accent",
    "progress_px": 2
  },
  "app": {
    "card_radius": 4,
    "thumb_radius": 4,
    "panel_radius": 4,
    "search_radius": 5,
    "search_border": 0.17,
    "search_alpha": 0.07,
    "accent_controls": true,
    "text_dim": "#d6bdb1",
    "np_solid": "#30261e",
    "heading_px": 22,
    "bar_border": true,
    "bar_alpha": 1,
    "controls": {
      "accent_primary": true
    },
    "search_look": {
      "height": 39,
      "max_px": 840
    }
  }
}
